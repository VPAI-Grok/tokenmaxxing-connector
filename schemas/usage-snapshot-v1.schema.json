{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenmaxxing:schema:usage-snapshot:v1",
  "title": "UsageSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "deviceId", "challengeId", "connectorVersion",
    "codexVersion", "observedAt", "fingerprintVersion", "accountFingerprint",
    "consentVersion", "metrics", "previousReceiptHash", "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deviceId": { "type": "string", "format": "uuid" },
    "challengeId": { "type": "string", "format": "uuid" },
    "connectorVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "codexVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "observedAt": { "type": "string", "format": "date-time" },
    "fingerprintVersion": { "const": 1 },
    "accountFingerprint": { "type": "string", "pattern": "^v1:[A-Za-z0-9_-]{43}$" },
    "consentVersion": { "const": 1 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifetimeTokens", "peakDailyTokens", "longestRunningTurnSec",
        "currentStreakDays", "longestStreakDays", "dailyUsageBuckets"
      ],
      "properties": {
        "lifetimeTokens": { "$ref": "#/$defs/nullableDecimal" },
        "peakDailyTokens": { "$ref": "#/$defs/nullableDecimal" },
        "longestRunningTurnSec": { "$ref": "#/$defs/nullableDecimal" },
        "currentStreakDays": { "$ref": "#/$defs/nullableUint32" },
        "longestStreakDays": { "$ref": "#/$defs/nullableUint32" },
        "dailyUsageBuckets": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["startDate", "tokens"],
                "properties": {
                  "startDate": { "type": "string", "format": "date" },
                  "tokens": { "$ref": "#/$defs/decimal" }
                }
              },
              "maxItems": 800
            }
          ]
        }
      }
    },
    "previousReceiptHash": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "decimal": {
      "description": "Canonical non-negative decimal string no greater than PostgreSQL bigint max (9223372036854775807)",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})$"
        },
        {
          "type": "string",
          "pattern": "^(?:[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
        }
      ]
    },
    "nullableDecimal": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/decimal" }]
    },
    "nullableUint32": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 100000 }
      ]
    }
  }
}
